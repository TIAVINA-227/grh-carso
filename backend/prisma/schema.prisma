generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id                      Int               @id @default(autoincrement())
  nom_utilisateur         String            @unique
  prenom_utilisateur      String?
  mot_de_passe            String
  email                   String            @unique
  role                    RoleUtilisateur   @default(EMPLOYE)
  statut                  StatutUtilisateur @default(ACTIF)
  date_creation           DateTime          @default(now())
  derniere_connexion      DateTime?
  premiere_connexion      Boolean           @default(true)
  mot_de_passe_temporaire String?
  token_reset_password    String?           @unique
  token_expiration        DateTime?
  avatar                  String?
  photo_couverture        String?           @default("#3B82F6")
  bio                     String?
  telephone               String?
  date_naissance          DateTime?
  adresse                 String?
  ville                   String?
  pays                    String?           @default("Madagascar")
  employeId               Int?              @unique
  conges                  Conge[]
  notifications           Notification[]
  sessions                Session[]
  employe                 Employe?          @relation(fields: [employeId], references: [id])

  @@map("utilisateurs")
}

model Employe {
  id             Int                @id @default(autoincrement())
  matricule      String             @unique
  nom            String
  prenom         String
  date_naissance DateTime
  adresse        String?
  email          String?            @unique
  telephone      String?
  date_embauche  DateTime
  departementId  Int?
  posteId        Int?
  absences       Absence[]
  conges         Conge[]
  contrat        Contrat?
  departement    Departement?       @relation(fields: [departementId], references: [id])
  poste          Poste?             @relation(fields: [posteId], references: [id])
  paiements      Paiement[]
  presences      Presence[]
  performances   SuiviPerformance[]
  utilisateur    Utilisateur?
}

model Departement {
  id              Int       @id @default(autoincrement())
  nom_departement String    @unique
  responsable     String?
  employes        Employe[]
}

model Poste {
  id          Int       @id @default(autoincrement())
  intitule    String
  description String?
  niveau      String?
  employes    Employe[]
}

model Contrat {
  id           Int           @id @default(autoincrement())
  type_contrat String
  date_debut   DateTime
  date_fin     DateTime?
  salaire_base Float
  statut       StatutContrat @default(ACTIF)
  employeId    Int           @unique
  employe      Employe       @relation(fields: [employeId], references: [id])
}

model Absence {
  id            Int      @id @default(autoincrement())
  date_debut    DateTime
  date_fin      DateTime
  type_absence  String
  justification String?
  piece_jointe  String?
  employeId     Int
  employe       Employe  @relation(fields: [employeId], references: [id])
}

model Presence {
  id                 Int            @id @default(autoincrement())
  date_jour          DateTime       @default(now())
  statut             StatutPresence @default(PRESENT)
  heures_travaillees Int?
  justification      String?
  employeId          Int
  employe            Employe        @relation(fields: [employeId], references: [id])
}

model Conge {
  id            Int         @id @default(autoincrement())
  type_conge    String?
  date_debut    DateTime
  date_fin      DateTime
  statut        StatutConge @default(SOUMIS)
  utilisateurId Int
  employeId     Int
  motif         String?
  duree_jours   Int?
  employe       Employe     @relation(fields: [employeId], references: [id])
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Notification {
  id            Int         @id @default(autoincrement())
  titre         String
  message       String
  type          String      @default("info")
  categorie     String?
  lue           Boolean     @default(false)
  date_creation DateTime    @default(now())
  date_lue      DateTime?
  metadata      Json?
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([lue])
  @@map("notifications")
}

model SuiviPerformance {
  id           Int      @id @default(autoincrement())
  date_eval    DateTime @default(now())
  note         Int
  resultat     String?
  commentaires String?
  objectifs    String?
  realisation  String?
  employeId    Int
  employe      Employe  @relation(fields: [employeId], references: [id])
}

model Paiement {
  id            Int              @id @default(autoincrement())
  date_paiement DateTime         @default(now())
  montant       Float
  mode_paiement String
  statut        StatutPaiement   @default(EFFECTUE)
  periode_debut DateTime
  periode_fin   DateTime
  employeId     Int
  bulletin      BulletinSalaire?
  employe       Employe          @relation(fields: [employeId], references: [id])
}

model BulletinSalaire {
  id           Int      @id @default(autoincrement())
  mois         Int
  annee        Int
  salaire_brut Float
  salaire_net  Float
  statut       String   @default("valide")
  paiementId   Int      @unique
  paiement     Paiement @relation(fields: [paiementId], references: [id])
}

model Session {
  id                Int         @id @default(autoincrement())
  heure_connexion   DateTime    @default(now())
  heure_deconnexion DateTime?
  duree_minutes     Int?
  ip_address        String?
  user_agent        String?
  utilisateurId     Int
  utilisateur       Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([heure_connexion])
  @@map("sessions")
}

enum StatutUtilisateur {
  ACTIF
  BLOQUE
}

enum RoleUtilisateur {
  SUPER_ADMIN
  ADMIN
  EMPLOYE
}

enum StatutContrat {
  ACTIF
  TERMINE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}

enum StatutConge {
  SOUMIS
  APPROUVE
  REJETE
}

enum StatutPaiement {
  EFFECTUE
  EN_ATTENTE
  ANNULE
}
